## 3. Core Implementation (The Primary Pipeline Gate)

Drop this unified clamping module directly into your core input routing layer to entirely replace the old independent UV clamping mechanics.

```javascript
/**
 * UNIVERSAL BOUNDARY CLAMPING ENGINE
 * Replaces the independent square UV-clamping layer at the pipeline root.
 */
function clampPipelineGazeUniversal(rawGaze, registeredNode) {
    const bounds = registeredNode.bounds;         // { center_x, center_y, width, height }
    const shape = registeredNode.shapeType;       // "CIRCLE", "CAPSULE", "RECTANGLE", "CUSTOM_POLY"
    const outline = registeredNode.visibleOutline; // Array of vertices: [{x, y}, {x, y}, ...]

    // 1. Project raw coordinates into invariant local space (Origin is node center)
    let localX = rawGaze.x - bounds.center_x;
    let localY = rawGaze.y - bounds.center_y;

    let conformedX = localX;
    let conformedY = localY;

    // 2. Shape-Aware Vector Clamping Switch
    switch (shape) {
        case "CIRCLE":
            let radius = bounds.width * 0.5;
            let radialDist = Math.sqrt(localX * localX + localY * localY);
            if (radialDist > radius) {
                // Vector Edge Projection: Replaces square UV corner sticking
                let scale = radius / radialDist;
                conformedX = localX * scale;
                conformedY = localY * scale;
            }
            break;

        case "CAPSULE":
            let halfWidth = bounds.width * 0.5;
            let halfHeight = bounds.height * 0.5;
            let spineHalfLen = halfWidth - halfHeight; // Assumes horizontal orientation
            
            // Find closest point along the inner linear spine
            let closestSpineX = Math.max(-spineHalfLen, Math.min(localX, spineHalfLen));
            let dx = localX - closestSpineX;
            let dy = localY;
            let distToSpine = Math.sqrt(dx * dx + dy * dy);
            
            if (distToSpine > halfHeight) {
                // Project gaze point onto the curved capsule cap bounds
                let scale = halfHeight / distToSpine;
                conformedX = closestSpineX + dx * scale;
                conformedY = dy * scale;
            }
            break;

        case "RECTANGLE":
            let extentX = bounds.width * 0.5;
            let extentY = bounds.height * 0.5;
            conformedX = Math.max(-extentX, Math.min(localX, extentX));
            conformedY = Math.max(-extentY, Math.min(localY, extentY));
            break;

        default:
            // ================================================================
            // UNIVERSAL GEOMETRIC CATCHALL (Pentagons, Stars, Custom Vectors)
            // ================================================================
            if (outline && outline.length >= 3) {
                // If gaze is natively inside the complex shape, pass through untampered
                if (isPointInPolygon(rawGaze, outline)) {
                    break; 
                }

                // If outside (in box corner dead zone), find where the ray pierces the outline
                let intersection = findRayPolygonIntersection(
                    bounds.center_x, bounds.center_y, 
                    rawGaze.x, rawGaze.y, 
                    outline
                );
                
                if (intersection) {
                    conformedX = intersection.x - bounds.center_x;
                    conformedY = intersection.y - bounds.center_y;
                }
            } else {
                // Absolute Structural Fallback: Clamp to bounding rectangle borders
                let fallbackX = bounds.width * 0.5;
                let fallbackY = bounds.height * 0.5;
                conformedX = Math.max(-fallbackX, Math.min(localX, fallbackX));
                conformedY = Math.max(-fallbackY, Math.min(localY, fallbackY));
            }
            break;
    }

    // 3. Transform conformed points back to screen space for the separate visual layer
    return {
        renderX: bounds.center_x + conformedX,
        renderY: bounds.center_y + conformedY
    };
}

/**
 * Fast Ray-to-Line intersection engine for the polygon catchall.
 */
function findRayPolygonIntersection(cx, cy, gx, gy, polygon) {
    let closestIntersection = null;
    let minDistance = Infinity;

    for (let i = 0; i < polygon.length; i++) {
        let p1 = polygon[i];
        let p2 = polygon[(i + 1) % polygon.length]; // Form loop back to vertex 0

        let intersect = checkLineIntersection(cx, cy, gx, gy, p1.x, p1.y, p2.x, p2.y);
        
        if (intersect) {
            let dist = Math.sqrt((intersect.x - cx) ** 2 + (intersect.y - cy) ** 2);
            if (dist < minDistance) {
                minDistance = dist;
                closestIntersection = intersect;
            }
        }
    }
    return closestIntersection;
}

/**
 * Constant-time algebraic line segment cross-product logic.
 */
function checkLineIntersection(x1, y1, x2, y2, x3, y3, x4, y4) {
    let denom = (y4 - y3) * (x2 - x1) - (x4 - x3) * (y2 - y1);
    if (denom === 0) return null; // Edge Case: Parallel vectors
    
    let ua = ((x4 - x3) * (y1 - y3) - (y4 - y3) * (x1 - x3)) / denom;
    let ub = ((x2 - x1) * (y1 - y3) - (y2 - y1) * (x1 - x3)) / denom;

    // Verify intersection sits boundaries of the segment lines
    if (ua >= 0 && ub >= 0 && ub <= 1) {
        return {
            x: x1 + ua * (x2 - x1),
            y: y1 + ua * (y2 - y1)
        };
    }
    return null;
}

/**
 * Standard Ray-Casting parity check to determine internal polygon states.
 */
function isPointInPolygon(point, polygon) {
    let inside = false;
    for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
        let xi = polygon[i].x, yi = polygon[i].y;
        let xj = polygon[j].x, yj = polygon[j].y;
        let intersect = ((yi > point.y) !== (yj > point.y)) && 
                        (point.x < (xj - xi) * (point.y - yi) / (yj - yi) + xi);
        if (intersect) inside = !inside;
    }
    return inside;
}
